  "baseline_checks": [
    {
      "test": "preflight rejects existing rootless cycles without repairs",
      "migration_aborted": true,
      "acyclic_rows": 8
    },
    {
      "test": "sequential creation rename reparent root and cycle checks",
      "acyclic_rows": 9
    },
    {
      "test": "multi-row updates and inserts rollback invalid graphs",
      "acyclic_rows": 10
    },
    {
      "test": "upsert cannot bypass integrity trigger",
      "acyclic_rows": 8
    },
    {
      "test": "repeated ancestor check terminates and rejects corrupt ancestry",
      "acyclic_rows": 8
    },
    {
      "test": "reciprocal reparenting",
      "isolation": "READ COMMITTED",
      "existing_guard": true,
      "winner": "first",
      "loser_sqlstate": "23514",
      "acyclic_rows": 8
    },
    {
      "test": "reciprocal reparenting",
      "isolation": "READ COMMITTED",
      "existing_guard": false,
      "winner": "first",
      "loser_sqlstate": "23514",
      "acyclic_rows": 8
    },
    {
      "test": "reciprocal reparenting",
      "isolation": "REPEATABLE READ",
      "existing_guard": true,
      "winner": "first",
      "loser_sqlstate": "40001",
      "acyclic_rows": 8
    },
    {
      "test": "reciprocal reparenting",
      "isolation": "REPEATABLE READ",
      "existing_guard": false,
      "winner": "first",
      "loser_sqlstate": "40001",
      "acyclic_rows": 8
    },
