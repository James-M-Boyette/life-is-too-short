        "C_to_A": "40001",
        "B_to_C": "40001"
      },
      "acyclic_rows": 8
    },
    {
      "test": "serialization failure rolls back prior writes",
      "sqlstate": "40001",
      "acyclic_rows": 8
    },
    {
      "test": "installation lock timeout aborts transaction",
      "sqlstate": "55P03",
      "configured_timeout": "5s",
      "acyclic_rows": 8
    },
    {
      "test": "different accounts do not share the guard",
      "acyclic_rows": 8
    },
    {
      "test": "deadlock rolls back prior writes",
      "sqlstate": "40P01",
      "victim_project": 1,
      "acyclic_rows": 8
    },
    {
      "test": "delete_project preserves promotion and task semantics",
      "acyclic_rows": 7
    },
    {
      "test": "delete wins reparent race",
      "loser_sqlstate": "23503",
      "acyclic_rows": 7
    },
    {
      "test": "reparent wins deletion race and child is promoted",
      "acyclic_rows": 7
    },
    {
      "test": "RLS and new guard permission boundaries",
      "role_checks": [
        "authenticated",
        "anon",
        "service_role"
