{
    "name": "life-is-too-short",
    "version": "0.0.0",
    "scripts": {
        "ng": "ng",
        "start": "ng serve --port 4300 --host 127.0.0.1",
        "build": "ng build",
        "build:dev": "ng build --configuration development",
        "watch": "ng build --watch --configuration development",
        "test": "ng test",

        "git:add": "git add -A",
        "git:commit": "git commit -m \"Build app\"",
        "git:push": "git push",

        "push": "pnpm run build && pnpm run git:add && pnpm run git:commit && pnpm run git:push"
    },
    "prettier": {
        "printWidth": 100,
        "singleQuote": true,
        "overrides": [
            {
                "files": "*.html",
                "options": {
                    "parser": "angular"
                }
            }
        ]
    },
    "private": true,
    "packageManager": "pnpm@9.15.9",
    "dependencies": {
        "@angular/common": "^21.1.0",
        "@angular/compiler": "^21.1.0",
        "@angular/core": "^21.1.0",
        "@angular/forms": "^21.1.0",
        "@angular/platform-browser": "^21.1.0",
        "@angular/router": "^21.1.0",
        "@primeuix/themes": "^2.0.3",
        "@supabase/supabase-js": "^2.96.0",
        "primeicons": "^7.0.0",
        "primeng": "^21.1.1",
        "rxjs": "~7.8.0",
        "tslib": "^2.3.0"
    },
    "devDependencies": {
        "@angular/build": "^21.1.4",
        "@angular/cli": "^21.1.4",
        "@angular/compiler-cli": "^21.1.0",
        "jsdom": "^27.1.0",
        "supabase": "^2.120.0",
        "typescript": "~5.9.2",
        "vitest": "^4.0.8"
    }
}
